# Copy to .env and adjust. .env is gitignored — never commit real secrets.
#
#   Copy-Item .env.example .env
#
# dev.ps1 loads this automatically. app.py reads every one of these from the
# environment already, so nothing in the app needs changing to use them.

# Where docker-compose.yml puts Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/velvet

# Pin this locally. Any fixed hex string works — this one is not a secret.
# Production must set it: with FLASK_DEBUG off, app.py refuses to serve
# without one rather than generating a throwaway key, because each gunicorn
# worker would generate a *different* one and log users out at random.
APP_SECRET_KEY=dev-only-not-a-secret-0123456789abcdef

# Flask reloader + debugger. This is what makes save-then-refresh work.
# It also selects "development" everywhere else in app.py: the auto-login
# shortcut, the insecure-cookie allowance, and the secret fallbacks above
# are all off without it. Never set this in production.
FLASK_DEBUG=1

# Skip the login screen entirely while iterating. Set to 0 to test auth.
AUTO_LOGIN=0

# Let the seeded demo members (seed_demo.py) be matched with you. They
# auto-reply and auto-continue, which is what makes local testing possible --
# and exactly why production must never set this. Without it a real deployment
# only ever pairs real people with each other.
ALLOW_BOT_MATCHES=1

# Admin login for /admin/profiles/new and /admin/reports. Production must
# set this too — the old default was a password published in this repo.
APP_ADMIN_PASSWORD=admin12345

# --- outbound mail ------------------------------------------------------
# Password reset and address confirmation. Without a key the app logs the
# email it would have sent (link included), which is enough to test both
# flows locally. Get one at https://resend.com.
RESEND_API_KEY=
# Until the domain is verified with the provider this has to stay on their
# sandbox sender; a From: on an unverified domain is rejected outright.
# Once velvt.nl is verified: MAIL_FROM=Velvt <noreply@velvt.nl>
MAIL_FROM=Velvt <onboarding@resend.dev>
# Where a reply to that mail lands. Falls back to SUPPORT_EMAIL when unset,
# so replies always reach whoever the imprint names.
MAIL_REPLY_TO=
# Absolute base for links in email. Falls back to CANONICAL_HOST, then to
# the request's own host — fine locally, never trusted in production.
APP_BASE_URL=http://127.0.0.1:5000

# Shown in the footer and on the legal pages as the way to reach a human.
# The DSA requires a published point of contact, so this must be an address
# someone actually reads -- an unmonitored or non-existent one is worse than
# useless, since the imprint is a legal statement that it works.
SUPPORT_EMAIL=support@velvt.example

# Shared secret for POST /tasks/purge-deletions, which finishes account
# deletions once their grace period expires. Cloud Run has no background
# worker, so a scheduler has to call it — daily is plenty. Unset means the
# endpoint refuses to run, which is the safe default for something that
# permanently erases accounts.
TASK_TOKEN=

# One instance locally, so the pool can stay small.
DB_POOL_MIN=1
DB_POOL_MAX=5
