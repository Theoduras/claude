# Copy to .env and adjust. .env is gitignored — never commit real secrets.
#
#   Copy-Item .env.example .env
#
# dev.ps1 loads this automatically. app.py reads every one of these from the
# environment already, so nothing in the app needs changing to use them.

# Where docker-compose.yml puts Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/velvet

# Pin this locally. app.py falls back to secrets.token_hex(32) when it is
# unset, which mints a fresh key on every reloader restart and silently logs
# you out mid-test. Any fixed hex string works — this one is not a secret.
APP_SECRET_KEY=dev-only-not-a-secret-0123456789abcdef

# Flask reloader + debugger. This is what makes save-then-refresh work.
FLASK_DEBUG=1

# Skip the login screen entirely while iterating. Set to 0 to test auth.
AUTO_LOGIN=0

# Admin login for /admin/profiles/new.
APP_ADMIN_PASSWORD=admin12345

# One instance locally, so the pool can stay small.
DB_POOL_MIN=1
DB_POOL_MAX=5
